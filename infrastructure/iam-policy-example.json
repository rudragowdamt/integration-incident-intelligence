{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIncidentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/incidents/*"
    },
    {
      "Sid": "WriteIncidentReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/reports/*"
    }
  ]
}